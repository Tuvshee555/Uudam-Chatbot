# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-start.log
.next-start.err.log

# env files (can opt-in for committing if needed)
.env*
# ...except the checked-in template, which holds no real values.
!.env.example

# editor
.vscode/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local files. Only the shared git auto-sync hook is committed: settings.local.json holds
# this machine's permission rules (they have held connection strings) and must never be committed.
.claude/*
!.claude/settings.json
!.claude/hooks/
.codex-logs/

# scratch dir — QA logs, sample exports, never committed
tmp/

# local data: trip/price backups and exports (real customer chats) — the repo is public, never commit
backups/
outputs/
