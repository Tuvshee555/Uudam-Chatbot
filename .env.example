# Copy to .env.local and fill in. Everything below the "Required" block has a
# safe default — you only need to set what you actually want to change.
#
# Names and defaults here mirror src/lib/env.ts; that file is the source of
# truth and validates every value at startup.

# ─────────────────────────────────────────────────────────────────────────────
# Required — the app refuses to serve a request without these
# ─────────────────────────────────────────────────────────────────────────────

OPENAI_API_KEY=sk-your-key
VERIFY_TOKEN=pick-any-string-and-paste-it-into-the-meta-webhook-setup
# Meta app secret. FACEBOOK_APP_SECRET / INSTAGRAM_APP_SECRET_KEY also accepted.
META_APP_SECRET=your-meta-app-secret
# Password for the admin panel (/admin) and every /api/admin/* route.
ADMIN_SECRET=a-long-random-string

# One deployment serves several pages. Preferred form — comma-separated
# pageId:token pairs (tokens may themselves contain ":", only the first is
# treated as the separator):
FACEBOOK_PAGES=111111111111111:EAA...token1,222222222222222:EAA...token2
# Legacy single-page fallback, still honoured if FACEBOOK_PAGES is unset:
# TOKEN_PAGE=EAA...
# FACEBOOK_PAGE_ID=111111111111111

# ─────────────────────────────────────────────────────────────────────────────
# Database — optional locally, required for anything to persist
# ─────────────────────────────────────────────────────────────────────────────

# Neon Postgres. DATABASE_URL is accepted as an alias.
NEON_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ─────────────────────────────────────────────────────────────────────────────
# Redis — optional locally, STRONGLY recommended in production
# ─────────────────────────────────────────────────────────────────────────────
#
# Without Redis, webhook replay protection, conversation state, staff pause and
# rate limiting all live in per-process memory. That is fine for one local
# server, but on Vercel several instances answer the same page and share
# nothing: customers can get the same reply twice and a staff pause set on one
# instance is invisible to the others. The readiness report warns about this.
#
# Set REDIS_URL directly, or the UPSTASH_REDIS_REST_* pair (which is converted
# into a rediss:// URL for you).

# REDIS_URL=rediss://default:password@host:6379
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# Each feature can be toggled independently. Default: on when Redis is
# configured, off when it is not.
# REDIS_STATE_ENABLED=true
# REDIS_RATE_LIMIT_ENABLED=true
# REDIS_REPLAY_ENABLED=true
# REDIS_CONVERSATION_ENABLED=true
# REDIS_PAUSE_ENABLED=true
# REDIS_KEY_PREFIX=uudamtravelbot
# REDIS_CONNECT_TIMEOUT_MS=1500
# REDIS_COMMAND_TIMEOUT_MS=750
# REDIS_LOCK_TTL_MS=30000

# ─────────────────────────────────────────────────────────────────────────────
# Access control
# ─────────────────────────────────────────────────────────────────────────────

# Never true in production — env validation rejects it there.
# ADMIN_OPEN_ACCESS=false
# Allows ?secret=... instead of the x-admin-secret header. Leaks into logs and
# browser history; off by default.
# ALLOW_ADMIN_SECRET_QUERY=false
# Trust x-forwarded-for / x-real-ip for client IPs. Defaults to true on Vercel.
# TRUST_PROXY_HEADERS=true
# Failed admin auth attempts allowed per IP per minute.
# ADMIN_AUTH_RATE_LIMIT=20
# Required in production for /api/cron/reminder; Vercel Cron sends it as
# "Authorization: Bearer <value>". Missing secret fails closed in production.
# CRON_SECRET=another-long-random-string

# ─────────────────────────────────────────────────────────────────────────────
# Limits and timeouts
# ─────────────────────────────────────────────────────────────────────────────

# DEMO_MAX_TEXT_CHARS=1000
# DEMO_GLOBAL_RATE_LIMIT=240
# WEBHOOK_MAX_BODY_BYTES=1048576
# WEBHOOK_MAX_PENDING_CONVERSATIONS=5000
# RATE_LIMIT_MAX_BUCKETS=20000
# RATE_LIMIT_SWEEP_INTERVAL=200
# CONVERSATION_MAX_SESSIONS=5000
# PAUSE_MAX_SENDERS=5000
# OPENAI_TIMEOUT_MS=15000
# OPENAI_MAX_RETRIES=2
# OPENAI_RETRY_BASE_DELAY_MS=300
# OPENAI_CIRCUIT_FAILURE_THRESHOLD=5
# OPENAI_CIRCUIT_COOLDOWN_MS=30000
# META_API_TIMEOUT_MS=12000
# META_SUBSCRIBE_MAX_RETRIES=1
# META_RETRY_BASE_DELAY_MS=300

# ─────────────────────────────────────────────────────────────────────────────
# Observability (optional)
# ─────────────────────────────────────────────────────────────────────────────

# OBSERVABILITY_LOG_SINK_URL=https://logs.example.com/ingest
# OBSERVABILITY_ERROR_SINK_URL=https://errors.example.com/ingest
# OBSERVABILITY_SINK_TOKEN=bearer-token-for-the-sinks
# OBSERVABILITY_SINK_TIMEOUT_MS=2000
# OBSERVABILITY_SINK_BATCH_SIZE=20

# ─────────────────────────────────────────────────────────────────────────────
# Staff alerts (optional)
# ─────────────────────────────────────────────────────────────────────────────

# Page-scoped IDs that receive new-lead pings on Messenger.
# STAFF_NOTIFY_PSIDS=1234567890,0987654321
# Telegram fallback — delivers even when Meta's 24h window blocks the Messenger
# ping. Only active when both are set.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# TELEGRAM_STAFF_CHAT_IDS=123456789,987654321

# ─────────────────────────────────────────────────────────────────────────────
# Google Drive price-list sync (optional, off by default)
# ─────────────────────────────────────────────────────────────────────────────

# GOOGLE_DRIVE_SYNC_ENABLED=false
# GOOGLE_DRIVE_FOLDER_ID=folder-id
# GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=svc@project.iam.gserviceaccount.com
# GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_DRIVE_SYNC_INTERVAL_MINUTES=30
# GOOGLE_DRIVE_SYNC_FILE_LIMIT=500

# ─────────────────────────────────────────────────────────────────────────────
# Media storage (optional)
# ─────────────────────────────────────────────────────────────────────────────

# Vercel Blob — required for poster/trip-photo uploads from the admin panel.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Risky features — off by default, read the note before enabling
# ─────────────────────────────────────────────────────────────────────────────

# Mass broadcast to past leads. Sending RESPONSE-type messages outside Meta's
# 24h window violates policy and can get the page suspended.
# BROADCAST_ENABLED=false

# QPay payments. Only active when QPAY_ENABLED=true AND every credential is set.
# QPAY_ENABLED=false
# QPAY_BASE_URL=https://merchant.qpay.mn/v2
# QPAY_USERNAME=
# QPAY_PASSWORD=
# QPAY_INVOICE_CODE=
